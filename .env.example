# Supabase (PostgreSQL)
# Copie este arquivo para .env.local e preencha os valores.
# NUNCA comite .env.local: ele ja esta coberto pelo .gitignore (.env*).

# URL do projeto Supabase, ex.: https://xxxxxxxxxxxx.supabase.co
SUPABASE_URL=

# Service role key (Dashboard > Project Settings > API Keys).
# Uso exclusivo no servidor: ignora RLS. Nunca exponha no cliente.
SUPABASE_SERVICE_ROLE_KEY=

# Segredo do HMAC que assina o cookie de sessao (AUTH_SESSION_SECRET).
# Opcional em desenvolvimento: se vazio, cai para SUPABASE_SERVICE_ROLE_KEY.
# Em producao, defina um valor proprio e longo (ex.: openssl rand -base64 48).
AUTH_SESSION_SECRET=

# Opcional: habilitam o resumo por IA dos produtos (Mastra).
# Principal gratuito via OpenRouter; DeepSeek direto é o fallback pago.
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
